# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in the values:   cp .env.example .env
# Never commit `.env` — it holds secrets. This example file is safe to commit.
# (Values in `.env.local`, if you create one, override values in `.env`.)
# ---------------------------------------------------------------------------

# Public URL of the app, without a trailing slash.
# Used in email links, the sitemap, robots.txt and social-media previews.
# Local development: http://localhost:3000   Production: https://your-domain.com
NEXT_PUBLIC_URL="http://localhost:3000"

# PostgreSQL connection string (e.g. a free database from https://neon.tech).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Email address of the site admin. Whoever signs in with this email can open /admin
# to approve or reject submitted companies, and receives "new submission" emails.
ADMIN_EMAIL="you@example.com"

# --- Authentication (Auth.js / NextAuth) ---
# Random secret used to sign login sessions. Generate one with:  npx auth secret
AUTH_SECRET=""
# Needed when running `npm start` locally or hosting anywhere other than Vercel
# (without it, sign-in fails with "UntrustedHost"). Vercel sets this automatically.
# AUTH_TRUST_HOST=true
# Google sign-in: create OAuth credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: <NEXT_PUBLIC_URL>/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# --- Emails (https://resend.com) ---
RESEND_API_KEY=""
# Optional. Sender address — its domain must be verified in Resend.
# Defaults to "<site name> <noreply@<domain of NEXT_PUBLIC_URL>>".
# EMAIL_FROM="My Site <noreply@your-domain.com>"

# --- Review moderation (https://console.anthropic.com) ---
# Used to check reviews for inappropriate content with Claude.
ANTHROPIC_API_KEY=""
